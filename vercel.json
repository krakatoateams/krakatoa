{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "**": false,
      "main": true
    }
  },
  "github": {
    "silent": true
  },
  "crons": [
    {
      "path": "/api/cron/storage-sweep",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/credit-expiry",
      "schedule": "30 3 * * *"
    },
    {
      "path": "/api/cron/creation-expiry",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/cleanup-failed-posts",
      "schedule": "30 4 * * *"
    },
    {
      "path": "/api/cron/generation-reconcile",
      "schedule": "0 5 * * *"
    }
  ]
}
