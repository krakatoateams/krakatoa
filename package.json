{
  "name": "landing",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "WATCHPACK_POLLING=true next dev -p 3000",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "icons:generate": "node scripts/generate-pwa-icons.mjs",
    "db:setup": "node scripts/setup-db.mjs",
    "db:setup-product-photo": "node scripts/setup-db.mjs",
    "storage:migrate-layout": "node scripts/migrate-storage-layout.mjs",
    "storage:migrate-user-first": "node scripts/migrate-storage-user-first.mjs",
    "storage:list-orphans": "npx tsx scripts/list-storage-orphans.ts",
    "test:idempotency": "npx tsx lib/generation-idempotency-self-check.ts",
    "test:generation-commit": "npx tsx lib/generation-commit-self-check.ts",
    "test:recoverable-refund": "npx tsx lib/pipeline-recovery/refund-policy-pure.ts",
    "test:monitoring-flags": "npx tsx lib/admin-monitoring-flags.ts",
    "test:animate-handoff": "npx tsx lib/animate-handoff.ts",
    "test:aspect-ratio": "npx tsx lib/aspect-ratio-match.ts",
    "test:active-generations": "npx tsx lib/active-generations-pure.ts",
    "test:replicate-output-url": "npx tsx lib/replicate-output-url-self-check.ts",
    "test:generation-workflows": "npx tsx lib/generation-workflows/control-policy-self-check.ts && npx tsx lib/generation-workflows/stop-settlement-self-check.ts && npx tsx lib/generation-workflows/submission-fence-self-check.ts && npx tsx lib/generation-workflows/submission-recovery-self-check.ts && npx tsx lib/generation-workflows/webhook-token-self-check.ts && npx tsx lib/generation-workflows/polling-self-check.ts && npx tsx lib/generation-workflows/finalization-self-check.ts",
    "admin:probe-monitoring": "npx tsx scripts/probe-monitoring.ts",
    "probe:signed-url-cache": "npx tsx scripts/probe-signed-url-cache.ts",
    "cron:test": "node -e \"fetch('http://localhost:3000/api/cron').then(r=>r.json()).then(console.log)\""
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.105.4",
