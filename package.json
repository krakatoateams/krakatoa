    "ogl": "^1.0.11",
    "react": "^18",
    "react-dom": "^18",
    "replicate": "^1.4.0",
    "shaders": "^2.5.126",
    "workflow": "^4.8.4"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.5.0",
    "eslint": "^8",
    "eslint-config-next": "^14.2.35",
    "pg": "^8.21.0",
    "png-to-ico": "^3.0.2",
    "postcss": "^8",
    "postcss-import": "^16.1.1",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  },
  "overrides": {
    "nanoid": "3.3.18",
    "@workflow/core": {
      "nanoid": "5.1.16"
    },
    "@workflow/world-local": {
      "undici": "7.29.0"
    },
